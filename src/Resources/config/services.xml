<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Vertex Tax File Logger -->
        <service id="vertex_tax.log_handler" class="Monolog\Handler\RotatingFileHandler">
            <argument>%kernel.logs_dir%/vertex_tax_%kernel.environment%.log</argument>
            <argument>14</argument><!-- max files -->
        </service>

        <service id="monolog.logger.vertex_tax" class="Monolog\Logger">
            <argument>vertex_tax</argument>
            <call method="pushHandler">
                <argument type="service" id="vertex_tax.log_handler"/>
            </call>
        </service>

        <!-- Entity Definitions -->
        <service id="VertexTax\Core\Content\TaxProvider\TaxProviderDefinition">
            <tag name="shopware.entity.definition" entity="vertex_tax_provider"/>
        </service>
        <service id="VertexTax\Core\Content\TaxLog\TaxLogDefinition">
            <tag name="shopware.entity.definition" entity="vertex_tax_log"/>
        </service>
        <service id="VertexTax\Core\Content\Extension\TaxExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="VertexTax\Core\Content\Extension\TaxExtensionDefinition">
            <tag name="shopware.entity.definition" entity="vertex_tax_mapping" />
        </service>

        <!-- Cart Processor -->
        <service id="VertexTax\Core\Checkout\Cart\Collector\VertexTaxCollector">
            <argument type="service" id="tax.repository" />
            <argument type="service" id="vertex_tax_provider.repository" />
            <argument type="service" id="VertexTax\Core\Tax\TaxCalculatorRegistry"/>
            <tag name="shopware.cart.processor" />
        </service>

        <service id="VertexTax\Service\Log\TaxLogWriter">
            <argument type="service" id="vertex_tax_log.repository" />
            <argument type="service" id="monolog.logger.vertex_tax"/>
        </service>

        <!-- Tax Calculator -->
        <service id="VertexTax\Core\Vertex\Calculator" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="VertexTax\Service\Log\TaxLogWriter" />
            <argument type="service" id="cache.object"/>
            <argument type="service" id="VertexTax\Service\Api\VertexApiClient"/>
            <argument type="service" id="VertexTax\Service\Builder\VertexTransactionBuilder"/>
            <argument type="service" id="monolog.logger.vertex_tax"/>
            <tag name="vertex.tax_calculator"/>
        </service>

        <!-- Tax Calculator Registry -->
        <service id="VertexTax\Core\Tax\TaxCalculatorRegistry">
            <argument type="tagged_iterator" tag="vertex.tax_calculator"/>
        </service>

        <!-- API Services -->
        <service id="VertexTax\Service\Auth\VertexAuthService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="monolog.logger.vertex_tax"/>
        </service>

        <service id="VertexTax\Service\Api\VertexApiClient">
            <argument type="service" id="VertexTax\Service\Auth\VertexAuthService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="monolog.logger.vertex_tax"/>
        </service>

        <!-- Cart Promotion Discount Extractor -->
        <service id="VertexTax\Service\Cart\CartPromotionDiscountExtractor"/>

        <!-- Transaction Builder -->
        <service id="VertexTax\Service\Builder\VertexTransactionBuilder">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="product.repository" />
            <argument type="service" id="VertexTax\Service\Cart\CartPromotionDiscountExtractor"/>
        </service>

        <!-- Address Validator -->
        <service id="VertexTax\Service\Address\AddressValidatorService"/>

        <!-- Delivery State -->
        <service id="VertexTax\Service\Order\DeliveryStateTransitionService">
            <argument type="service" id="state_machine.registry"/>
            <argument type="service" id="monolog.logger.vertex_tax"/>
        </service>

        <!-- Event Subscribers -->
        <service id="VertexTax\Subscriber\OrderSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="VertexTax\Service\Log\TaxLogWriter" />
            <argument type="service" id="order.repository" />
            <argument type="service" id="VertexTax\Service\Api\VertexApiClient"/>
            <argument type="service" id="VertexTax\Service\Builder\VertexTransactionBuilder"/>
            <argument type="service" id="VertexTax\Service\Cart\CartPromotionDiscountExtractor"/>
            <argument type="service" id="monolog.logger.vertex_tax"/>
        </service>

        <!-- Controllers -->
        <service id="VertexTax\Storefront\Controller\TestConnectionController" public="true">
            <argument type="service" id="VertexTax\Service\Api\VertexApiClient"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="VertexTax\Storefront\Controller\TaxLogAdminController" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
